{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
