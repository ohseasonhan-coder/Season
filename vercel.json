{
  "buildCommand": "npm install --include=dev && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest|icon\\.svg|robots\\.txt|favicon\\.).+\\.(js|css|png|svg|ico|woff|woff2|ttf|json|webp|jpg|jpeg|gif|map|txt))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
